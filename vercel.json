{
  "version": 2,
  "buildCommand": "cd frontend-next && npm install && npm run build",
  "outputDirectory": "frontend-next/.next",
  "installCommand": "cd frontend-next && npm install",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    }
  ]
}