{
    "info": {
        "name": "ERP Sistema - API",
        "description": "Colección completa para el sistema ERP con GraphQL - CAMPOS CORREGIDOS",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000",
            "type": "string"
        },
        {
            "key": "graphqlUrl",
            "value": "{{baseUrl}}/graphql",
            "type": "string"
        },
        {
            "key": "token",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "1. Login Admin",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const jsonData = pm.response.json();",
                                    "    if (jsonData.data && jsonData.data.login) {",
                                    "        pm.environment.set(\"token\", jsonData.data.login.accessToken);",
                                    "        pm.collectionVariables.set(\"token\", jsonData.data.login.accessToken);",
                                    "        console.log(\"✅ Token guardado:\", jsonData.data.login.accessToken.substring(0, 20) + \"...\");",
                                    "    }",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "mutation Login {\n  login(loginInput: {\n    email: \"admin@erp.com\"\n    password: \"admin123\"\n  }) {\n    accessToken\n    user {\n      id\n      email\n      role\n      firstName\n      lastName\n    }\n  }\n}",
                                "variables": ""
                            }
                        },
                        "url": {
                            "raw": "{{graphqlUrl}}",
                            "host": [
                                "{{graphqlUrl}}"
                            ]
                        }
                    }
                },
                {
