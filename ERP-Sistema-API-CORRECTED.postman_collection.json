                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const jsonData = pm.response.json();",
                                    "    if (jsonData.data && jsonData.data.register) {",
                                    "        console.log(\"✅ Usuario registrado:\", jsonData.data.register.user.email);",
                                    "    }",
                                    "}"
                                ],
