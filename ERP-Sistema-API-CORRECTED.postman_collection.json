                                "query": "mutation Register {\n  register(registerInput: {\n    email: \"nuevo@empresa.com\"\n    username: \"nuevousuario\"\n    password: \"password123\"\n    firstName: \"Nuevo\"\n    lastName: \"Usuario\"\n  }) {\n    accessToken\n    user {\n      id\n      email\n      role\n      firstName\n      lastName\n    }\n  }\n}",
