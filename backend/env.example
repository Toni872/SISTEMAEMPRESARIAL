# Database Configuration
# IMPORTANTE: Cambia la contraseña en producción
# Genera una contraseña segura: python -c "import secrets; print(secrets.token_urlsafe(32))"
DATABASE_URL=postgresql://postgres:CHANGE_THIS_PASSWORD@localhost:5432/erp_db

# PostgreSQL Configuration (para docker-compose.yml)
POSTGRES_DB=erp_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
POSTGRES_PASSWORD_FILE=

# pgAdmin Configuration (opcional)
PGADMIN_EMAIL=admin@erp.com
PGADMIN_PASSWORD=CHANGE_THIS_PASSWORD
PGADMIN_PASSWORD_FILE=

# JWT Configuration
# CRÍTICO: Genera una SECRET_KEY segura para producción
# Genera una: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Mínimo 32 caracteres para seguridad adecuada
SECRET_KEY=CHANGE_THIS_SECRET_KEY_MIN_32_CHARS_GENERATE_WITH_SECRETS_TOKEN_URLSAFE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
PASSWORD_HASH_ALGORITHM=bcrypt

# Email Configuration (Optional)
# Para Gmail, usa una "App Password" en lugar de tu contraseña normal
# https://support.google.com/accounts/answer/185833
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@erp.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=ERP Sistema
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True
VALIDATE_CERTS=True

# Verifactu/AEAT Configuration (Optional)
# IMPORTANTE: Los certificados y contraseñas son información sensible
# Nunca subas certificados (.p12, .pfx) al repositorio
VERIFACTU_CERTIFICATES_DIR=certificates
AEAT_BASE_URL=https://sede.agenciatributaria.gob.es/verifactu/api
AEAT_CERTIFICATE_PATH=
AEAT_CERTIFICATE_PASSWORD=
AEAT_AUTO_SEND=False

# Sentry Configuration (Optional - para error tracking en producción)
SENTRY_DSN=

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# Environment
ENV=development
DEBUG=True

# Application
PROJECT_NAME=ERP Sistema Backend
VERSION=1.0.0
API_V1_STR=/api/v1

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://127.0.0.1:3001,http://127.0.0.1:3000

