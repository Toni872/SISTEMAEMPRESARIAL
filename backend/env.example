# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/erp_db

# JWT Configuration
SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
PASSWORD_HASH_ALGORITHM=bcrypt

# Email Configuration (Optional)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@erp.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=ERP Sistema
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True
VALIDATE_CERTS=True

# Verifactu/AEAT Configuration (Optional)
VERIFACTU_CERTIFICATES_DIR=certificates
AEAT_BASE_URL=https://sede.agenciatributaria.gob.es/verifactu/api
AEAT_CERTIFICATE_PATH=
AEAT_CERTIFICATE_PASSWORD=
AEAT_AUTO_SEND=False

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# Environment
ENV=development
DEBUG=True

# Application
PROJECT_NAME=ERP Sistema Backend
VERSION=1.0.0
API_V1_STR=/api/v1

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://127.0.0.1:3001,http://127.0.0.1:3000

