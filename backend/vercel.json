{
    "version": 2,
    "buildCommand": "npm run vercel-build",
    "outputDirectory": "dist",
    "framework": null,
    "installCommand": "npm install",
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/index.js"
        },
        {
            "src": "/graphql",
            "dest": "/api/index.js"
        },
        {
            "src": "/api-docs/(.*)",
            "dest": "/api/index.js"
        },
        {
            "src": "/health",
            "dest": "/api/index.js"
        }
    ],
    "functions": {
        "api/index.js": {
            "maxDuration": 30
        }
    },
    "env": {
        "NODE_ENV": "production"
    }
}